{
  "name": "deneuro.me",
  "version": "0.1.0",
  "private": true,
  "author": {
    "name": "Webber",
    "email": "webber@takken.io"
  },
  "type": "module",
  "scripts": {
    "next-start": "cross-env BROWSER=none next dev",
    "next-build": "next build",
    "tauri": "tauri",
    "build": "tauri build",
    "dev": "node scripts/ensure-husky.mjs && tauri dev",
    "lint": "yarn oxlint --deny-warnings --report-unused-disable-directives",
    "prepare": "husky",
    "setup:hooks": "node scripts/ensure-husky.mjs",
    "test": "node scripts/ensure-husky.mjs && vitest run",
    "format": "oxfmt --write",
    "format:check": "oxfmt --check",
    "typecheck": "tsgo --noEmit"
  },
  "dependencies": {
    "@headlessui/react": "^2.0.3",
    "@tauri-apps/api": "^1.5.4",
    "clsx": "^2.1.1",
    "next": "^14.2.3",
    "next-themes": "^0.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.33.3"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^1.5.13",
    "@testing-library/dom": "^10.1.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.12.10",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.0",
    "@typescript/native-preview": "^7.0.0-dev.20260504.1",
    "@vitejs/plugin-react-swc": "^4.3.0",
    "autoprefixer": "^10.4.19",
    "cross-env": "^7.0.3",
    "cssnano": "^7.0.1",
    "eslint": "^10.3.0",
    "eslint-config-next": "^14.2.3",
    "eslint-plugin-unicorn": "^64.0.0",
    "happy-dom": "^20.9.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.2",
    "oxfmt": "^0.47.0",
    "oxlint": "^1.62.0",
    "postcss": "^8.4.38",
    "postcss-import": "^16.1.0",
    "postcss-nesting": "^12.1.2",
    "tailwindcss": "^3.4.3",
    "typescript": "^5.4.5",
    "typescript-eslint": "^7.8.0",
    "vite": "^7",
    "vitest": "^4.1.5"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "packageManager": "yarn@4.14.1",
  "dependenciesMeta": {
    "@biomejs/biome": {
      "built": true
    },
    "sharp": {
      "built": true
    }
  },
  "lint-staged": {
    "*.@(ts|tsx|mts|js|jsx|mjs|cjs)": [
      "oxlint --fix --deny-warnings --report-unused-disable-directives",
      "oxfmt --write"
    ],
    "*.@(json|jsonc|json5|md|mdx|yaml|yml|css|scss|sass|html|toml)": "oxfmt --write",
    ".github/workflows/*.@(yml|yaml)": "actionlint"
  }
}
